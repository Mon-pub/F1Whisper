<?xml version="1.0" encoding="utf-8"?>
<!-- F1Whisper: override the self-updater failure dialog URL (shop.threema.ch -> our
     GitHub releases) for the onprem self-updater. Only the URL changes; the upstream
     translation is preserved verbatim per locale. -->
<resources>
    <string name="self_updater_installation_failed">Невозможно загрузить обновление. Загрузите и установите обновление с сайта <a href="https://github.com/Mon-pub/F1Whisper/releases">https://github.com/Mon-pub/F1Whisper/releases</a> вручную.</string>

    <!-- F1Whisper: mandatory-update gate strings. -->
    <string name="mandatory_update_countdown">Для продолжения использования этого сервера требуется более новая версия. Пожалуйста, обновитесь в течение %1$s.</string>
    <string name="mandatory_update_forced_title">Требуется обновление</string>
    <string name="mandatory_update_forced_body">Для продолжения использования этого сервера требуется более новая версия. Пожалуйста, обновитесь сейчас.</string>
    <!-- F1Whisper: mandatory-update action label + localized remaining-time plurals. -->
    <string name="mandatory_update_action">Обновить сейчас</string>
    <plurals name="mandatory_update_days">
        <item quantity="one">%d день</item>
        <item quantity="few">%d дня</item>
        <item quantity="many">%d дней</item>
        <item quantity="other">%d дня</item>
    </plurals>
    <plurals name="mandatory_update_hours">
        <item quantity="one">%d час</item>
        <item quantity="few">%d часа</item>
        <item quantity="many">%d часов</item>
        <item quantity="other">%d часа</item>
    </plurals>
</resources>
