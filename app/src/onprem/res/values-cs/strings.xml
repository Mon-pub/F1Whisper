<?xml version="1.0" encoding="utf-8"?>
<!-- F1Whisper: override the self-updater failure dialog URL (shop.threema.ch -> our
     GitHub releases) for the onprem self-updater. Only the URL changes; the upstream
     translation is preserved verbatim per locale. -->
<resources>
    <string name="self_updater_installation_failed">Stažení aktualizace selhalo. Stáhněte a nainstalujte aktualizaci z <a href="https://github.com/Mon-pub/F1Whisper/releases">https://github.com/Mon-pub/F1Whisper/releases</a> ručně.</string>

    <!-- F1Whisper: mandatory-update gate strings. -->
    <string name="mandatory_update_countdown">Pro další používání tohoto serveru je vyžadována novější verze. Prosím, aktualizujte do %1$s.</string>
    <string name="mandatory_update_forced_title">Vyžadována aktualizace</string>
    <string name="mandatory_update_forced_body">Pro další používání tohoto serveru je vyžadována novější verze. Prosím, aktualizujte nyní.</string>
    <!-- F1Whisper: mandatory-update action label + localized remaining-time plurals. -->
    <string name="mandatory_update_action">Aktualizovat nyní</string>
    <plurals name="mandatory_update_days">
        <item quantity="one">%d den</item>
        <item quantity="few">%d dny</item>
        <item quantity="many">%d dne</item>
        <item quantity="other">%d dní</item>
    </plurals>
    <plurals name="mandatory_update_hours">
        <item quantity="one">%d hodina</item>
        <item quantity="few">%d hodiny</item>
        <item quantity="many">%d hodiny</item>
        <item quantity="other">%d hodin</item>
    </plurals>
</resources>
