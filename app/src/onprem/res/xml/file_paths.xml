<?xml version="1.0" encoding="utf-8"?>
<paths>
    <files-path
        name="tmp_files"
        path="tmp/" />
    <cache-path
        name="cache_files"
        path="/" />
    <external-path
        name="ext_files"
        path="F1WhisperOnPrem/" />
    <!-- F1Whisper: the in-app self-updater (ApkUpdateDownloadService) downloads the APK into the
         app-private external files dir (getExternalFilesDir("Download")); expose it so the downloaded
         apk can be handed to the system package installer via a FileProvider content:// uri. -->
    <external-files-path
        name="onprem_update_apk"
        path="Download/" />
</paths>
