    <string name="self_updater_installation_failed">Güncellemenin indirilmesi başarısız oldu. Lütfen güncellemeyi <a href="https://github.com/Mon-pub/F1Whisper/releases">https://github.com/Mon-pub/F1Whisper/releases</a> adresinden manuel olarak indirip yükleyin.</string>

    <!-- F1Whisper: mandatory-update gate strings. -->
