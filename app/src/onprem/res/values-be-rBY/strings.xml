<!-- F1Whisper: override the self-updater failure dialog URL (shop.threema.ch -> our
     GitHub releases) for the onprem self-updater. Only the URL changes; the upstream
     translation is preserved verbatim per locale. -->
<resources>
    <string name="self_updater_installation_failed">Не ўдалося спампаваць абнаўленне. Калі ласка, спампуйце і ўсталюйце яго ўручную з <a href="https://github.com/Mon-pub/F1Whisper/releases">https://github.com/Mon-pub/F1Whisper/releases</a>.</string>

    <!-- F1Whisper: mandatory-update gate strings. -->
    <string name="mandatory_update_countdown">Для далейшага выкарыстання гэтага сервера патрабуецца больш новая версія. Калі ласка, абнавіцеся на працягу %1$s.</string>
    <string name="mandatory_update_forced_title">Патрабуецца абнаўленне</string>
    <string name="mandatory_update_forced_body">Для далейшага выкарыстання гэтага сервера патрабуецца больш новая версія. Калі ласка, абнавіцеся зараз.</string>
