<?xml version="1.0" encoding="utf-8"?>
<!--
 F1Whisper: a single editable row inside the "Edit checklist" dialog (RecyclerView + ItemTouchHelper).
 A drag handle on the start side (long-press/touch to reorder via a real drag), the item name in the
 middle (tap to rename), and a delete button on the end side. Apply re-broadcasts the modified
 checklist over the existing Poll wire; receivers merge it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/checklist_edit_drag_handle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@drawable/ic_outline_reorder_24"
        android:alpha="0.7"
        android:contentDescription="@string/checklist_reorder_item"
        app:tint="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/checklist_edit_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:background="?attr/selectableItemBackground"
        android:minHeight="40dp"
        android:gravity="center_vertical"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurface" />

    <ImageView
        android:id="@+id/checklist_edit_delete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@drawable/ic_delete_outline"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/checklist_delete_button"
        app:tint="?attr/colorError" />

</LinearLayout>
