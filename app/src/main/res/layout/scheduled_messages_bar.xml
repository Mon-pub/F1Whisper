<?xml version="1.0" encoding="utf-8"?>
<!-- F1Whisper: thin indicator chip shown at the top of a conversation when it has pending
     scheduled messages. Tapping it opens the scheduled-messages list/cancel dialog. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scheduled_messages_bar"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal|top"
    android:layout_marginTop="8dp"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone"
    app:cardBackgroundColor="?attr/colorSecondaryContainer"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/scheduled_messages_title"
            android:src="@drawable/ic_schedule"
            app:tint="?attr/colorOnSecondaryContainer" />

        <TextView
            android:id="@+id/scheduled_messages_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSecondaryContainer"
            tools:text="2 scheduled" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
