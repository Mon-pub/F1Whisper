<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ F1Whisper: disappearing-messages duration picker bottom sheet. A drag handle, a title, a short
  ~ explanatory summary, a single scrolling wheel of fixed durations (Off / 30s / 5m / 1h / 8h /
  ~ 1d / 1w / 4w, Signal-style), and a confirm button. Built from platform bottom-sheet metrics so
  ~ it looks native; theme tokens only, RTL-safe (a single label wheel, no time digits to mirror).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:id="@+id/drag_handle"
        style="@style/Threema.BottomSheet.DragHandle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:id="@+id/disappearing_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:text="@string/disappearing_duration_picker_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/disappearing_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/disappearing_messages_summary"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!--
      F1Whisper: the honest-limits line. Disappearing messages are client-enforced and F1Whisper-only,
      and until this was shown the user was never told either. The string has been translated into
      all 29 shipped locales since the feature landed and was referenced by nothing.
    -->
    <TextView
        android:id="@+id/disappearing_unsupported_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/disappearing_messages_unsupported"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <NumberPicker
        android:id="@+id/duration_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:theme="@style/Threema.NumberPicker" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/disappearing_confirm_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:minHeight="52dp"
        android:text="@string/ok"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        app:cornerRadius="14dp" />

</LinearLayout>
