<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp">

    <ch.threema.app.ui.ControllerView
        android:id="@+id/controller"
        android:layout_width="@dimen/avatar_size_small"
        android:layout_height="@dimen/avatar_size_small"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:contentDescription="@string/ballot_placeholder" />

    <ch.threema.app.emojis.EmojiConversationTextView
        style="@style/Threema.Bubble.Text.Body"
        android:id="@+id/text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/chat_bubble_container_padding_left_right"
        android:layout_toEndOf="@id/controller"
        android:linksClickable="false"
        android:text="Title" />

    <TextView
        style="@style/Threema.Bubble.Text.Body.Small"
        android:id="@+id/secondary_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/chat_bubble_container_padding_left_right"
        android:layout_below="@id/text_view"
        android:layout_alignStart="@id/text_view"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="Tap" />

    <!--
     F1Whisper: interactive checklist rows are inflated into this container when the ballot's
     displayType == CHECKLIST. Hidden (and the controller/text affordance used instead) for normal
     polls.
    -->
    <LinearLayout
        android:id="@+id/checklist_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/secondary_text_view"
        android:layout_alignStart="@id/text_view"
        android:paddingStart="@dimen/chat_bubble_container_padding_left_right"
        android:paddingTop="4dp"
        android:orientation="vertical"
        android:visibility="gone" />

</RelativeLayout>
