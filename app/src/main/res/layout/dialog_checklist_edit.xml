<?xml version="1.0" encoding="utf-8"?>
<!--
 F1Whisper: the "Edit checklist" dialog body. Hosts a RecyclerView of editable item rows driven by an
 ItemTouchHelper so the creator can REORDER items with a real long-press drag (the in-bubble ListView
 can't host a working drag), rename an item by tapping it, delete an item, and add a new one. On Apply
 the resulting order/set is persisted locally and re-broadcast over the existing Poll wire; receivers
 merge it via mergeChecklistUpdate(). Cancel/Apply are the hosting AlertDialog's buttons.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/checklist_edit_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="360dp"
        android:overScrollMode="ifContentScrolls"
        android:nestedScrollingEnabled="true" />

    <LinearLayout
        android:id="@+id/checklist_edit_add_row"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:minHeight="48dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_add"
            android:contentDescription="@string/checklist_add_item_title"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="0dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorPrimary"
            android:text="@string/checklist_add_item_title" />

    </LinearLayout>

</LinearLayout>
