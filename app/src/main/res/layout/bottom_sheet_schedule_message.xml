<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ F1Whisper: Telegram-style scheduled-message picker bottom sheet.
  ~ A title, three scrolling wheels (day / hour / minute, plus an optional AM/PM wheel for
  ~ 12-hour locales) and a big confirm button that shows the resolved send time.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:id="@+id/drag_handle"
        style="@style/Threema.BottomSheet.DragHandle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:id="@+id/schedule_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:text="@string/schedule_message"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:layoutDirection="ltr"
        android:orientation="horizontal">

        <!--
          ~ F1Whisper: the wheel row is forced LTR so the time always reads hour:minute (e.g. 08:59)
          ~ in both RTL and LTR locales; otherwise RTL mirroring swaps them to minute:hour. The day /
          ~ AM-PM labels inside each wheel still render in the locale's own script.
        -->
        <NumberPicker
            android:id="@+id/day_picker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.4"
            android:theme="@style/Threema.NumberPicker" />

        <NumberPicker
            android:id="@+id/hour_picker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:theme="@style/Threema.NumberPicker" />

        <NumberPicker
            android:id="@+id/minute_picker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:theme="@style/Threema.NumberPicker" />

        <NumberPicker
            android:id="@+id/ampm_picker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:theme="@style/Threema.NumberPicker"
            android:visibility="gone" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/schedule_confirm_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:minHeight="52dp"
        android:text="@string/schedule_message"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        app:cornerRadius="14dp" />

</LinearLayout>
