<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="@dimen/poll_matrix_cell_height"
    android:layout_width="wrap_content">

    <LinearLayout
        android:id="@+id/cell"
        android:layout_height="@dimen/poll_matrix_cell_height"
        android:layout_width="match_parent"
        android:background="@color/poll_detail_highlight_bg_color"
        android:layout_marginBottom="@dimen/poll_matrix_cell_border"
        android:layout_marginEnd="@dimen/poll_matrix_cell_border"
        android:padding="8dp"
        android:layout_gravity="center_vertical|end"
        android:gravity="center_vertical|end">

        <TextView
            style="@style/Threema.TextAppearance.PollDetailText"
            android:id="@+id/voting_sum"
            android:text="20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:singleLine="true"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>
</LinearLayout>
