<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ F1Whisper connectivity diagnostics dialog layout.
  ~
  ~ Two visual states share this layout:
  ~   - progress_container: shown while the probe battery runs (spinner + "Running checks…").
  ~   - results_container:   shown once the ProbeReport is ready (verdict + per-probe pass/fail list).
  ~
  ~ The per-probe rows and DNS rows are added programmatically into results_list, so the layout only
  ~ declares the fixed scaffolding. DIAGNOSIS ONLY — this UI never triggers any circumvention.
  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/grid_unit_x1">

    <!-- Progress state -->
    <LinearLayout
        android:id="@+id/progress_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/grid_unit_x3"
        android:paddingEnd="@dimen/grid_unit_x3"
        android:paddingTop="@dimen/grid_unit_x2"
        android:paddingBottom="@dimen/grid_unit_x2">

        <ProgressBar
            android:id="@+id/progress_spinner"
            android:layout_width="@dimen/grid_unit_x4"
            android:layout_height="@dimen/grid_unit_x4"
            android:layout_marginEnd="@dimen/grid_unit_x2" />

        <TextView
            android:id="@+id/progress_text"
            style="@style/Threema.MaterialAlertDialog.Body.Style"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connectivity_probe_running" />

    </LinearLayout>

    <!-- Results state -->
    <ScrollView
        android:id="@+id/results_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/grid_unit_x3"
            android:paddingEnd="@dimen/grid_unit_x3"
            android:paddingBottom="@dimen/grid_unit_x1">

            <!-- The heuristic verdict, in the user's language. -->
            <TextView
                android:id="@+id/verdict_text"
                style="@style/Threema.MaterialAlertDialog.Body.Style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/grid_unit_x2"
                android:textStyle="bold" />

            <!-- Per-probe / per-resolver rows are inflated into here at runtime. -->
            <LinearLayout
                android:id="@+id/results_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
